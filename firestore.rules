rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cadastro de novas revendedoras (leads)
    match /leads/{leadId} {
      allow read, write: if true;
    }
    
    // Gestão de kits consignados e acertos
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Configurações do distribuidor e regras de comissão
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Gestão de contas de administradores
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Gestão de fotos, vídeos e novidades do carrossel
    match /media_items/{mediaId} {
      allow read, write: if true;
    }

    // Dispositivos e inscrições de Web Push das revendedoras
    match /reseller_devices/{deviceId} {
      allow read, write: if true;
    }

    // Contas de revendedoras cadastradas
    match /resellers/{resellerId} {
      allow read, write: if true;
    }

    // Perfis de atendimento e datas de retorno
    match /sales_profiles/{profileId} {
      allow read, write: if true;
    }

    // Logs e histórico de disparos de Web Push
    match /web_push_logs/{logId} {
      allow read, write: if true;
    }
  }
}
