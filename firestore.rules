rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados pessoais e de gestão ficam SOMENTE no Supabase protegido.
    // Estas coleções não são mais usadas pelo site: bloqueadas.
    match /leads/{id}            { allow read, write: if false; }
    match /orders/{id}           { allow read, write: if false; }
    match /settings/{id}         { allow read, write: if false; }
    match /admin_users/{id}      { allow read, write: if false; }
    match /sales_profiles/{id}   { allow read, write: if false; }

    // Status do aparelho da vendedora (sem CPF, telefone ou senha)
    match /resellers/{id} {
      allow read: if false;
      allow write: if request.resource.data.keys().hasOnly(['id', 'active', 'deviceAuthorized', 'lastDeviceName', 'updatedAt']);
    }

    // Aparelhos para notificações e histórico de envios (sem CPF/telefone)
    match /reseller_devices/{id} {
      allow read: if true;
      allow write: if request.resource.data.get('resellerCpf', '') == '' && request.resource.data.get('resellerPhone', '') == '';
    }
    match /web_push_logs/{id} { allow read, write: if true; }

    // Fotos e vídeos públicos do site
    match /media_items/{id} { allow read: if true; allow write: if false; }
  }
}
